# Setu validator configuration.
# Copy to `.env` (or pass --env-file <path>) and adjust as needed.
# Values already set in the process environment take precedence.

# Identity
VALIDATOR_ID=validator-1
VALIDATOR_KEY_FILE=

# Network
VALIDATOR_LISTEN_ADDR=0.0.0.0
VALIDATOR_HTTP_PORT=8080
VALIDATOR_P2P_PORT=9000

# Persistence (leave empty for memory-only mode)
VALIDATOR_DB_PATH=

# Seed peers: host1:port1,host2:port2
PEER_VALIDATORS=

# Genesis config file (optional)
GENESIS_FILE=

# Chain identity (default: setu-dev)
SETU_CHAIN_ID=setu-dev

# VLC delta threshold that triggers folding
VLC_DELTA_THRESHOLD=10
